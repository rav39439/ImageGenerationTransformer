def inspect_weights(path):

    print("\n" + "=" * 60)
    print(os.path.basename(path))
    print("=" * 60)

    with h5py.File(path, "r") as f:

        def visitor(name, obj):

            if isinstance(obj, h5py.Dataset):

                print(
                    name,
                    "| Shape:", obj.shape,
                    "| Dtype:", obj.dtype
                )

        f.visititems(visitor)


