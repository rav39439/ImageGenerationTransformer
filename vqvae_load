    # -------------------------------------------------

    decoder_path = os.path.join(
        model_dir,
        "decoder_epoch.weights.h5"
    )

    dec.load_weights(decoder_path)

    print("Decoder weights loaded!")

    # -------------------------------------------------
    # 5. Load actual VQ codebook
    # -------------------------------------------------

    vq_path = os.path.join(
        model_dir,
        "vq_epoch.npy"
    )

    vq_data = np.load(vq_path, allow_pickle=True)

