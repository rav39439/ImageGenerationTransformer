def preprocess_image(image_path):

    # Read one image from disk.

    image_bytes = tf.io.read_file(
        image_path
    )

    # Decode image.

    image_tensor = tf.io.decode_image(
        image_bytes,
        channels=3,
        expand_animations=False
    )

    image_tensor.set_shape(
        [None, None, 3]
    )

    # Normalize uint8 [0,255] into float32 [0,1].

    image_tensor = tf.image.convert_image_dtype(
        image_tensor,
        tf.float32
    )

    # Resize to 224 x 224.

    image_tensor = tf.image.resize(
        image_tensor,
        IMAGE_SIZE
    )

    image_tensor = tf.ensure_shape(
        image_tensor,
        [
            IMAGE_SIZE[0],
            IMAGE_SIZE[1],
            3
        ]
    )

    return image_tensor


# ============================================================
# 5. CREATE STREAMING DATASET
# ============================================================

def create_image_dataset(
    paths,
    training=True
):

    dataset = tf.data.Dataset.from_tensor_slices(
        paths
    )

    # Shuffle paths, not decoded image tensors.

    if training:

        dataset = dataset.shuffle(
            buffer_size=min(
                len(paths),
                SHUFFLE_BUFFER
            ),
            seed=RANDOM_SEED,
            reshuffle_each_iteration=True
        )

    # Load images lazily.

    dataset = dataset.map(
        preprocess_image,
        num_parallel_calls=PARALLEL_MAP_CALLS,
        deterministic=not training
    )

    # Batch before distribution across GPUs.

    dataset = dataset.batch(
        GLOBAL_BATCH_SIZE,
        drop_remainder=True
    )

    # Limit CPU memory occupied by queued batches.

    dataset = dataset.prefetch(
        PREFETCH_BATCHES
    )

    # Limit private CPU thread usage.

    options = tf.data.Options()

    options.threading.private_threadpool_size = 4

    options.threading.max_intra_op_parallelism = 1

    dataset = dataset.with_options(
        options
    )

    return dataset


