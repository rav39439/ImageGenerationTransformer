class SaveVQVAEWeights(
    keras.callbacks.Callback
):

    def on_epoch_end(
        self,
        epoch,
        logs=None
    ):

        epoch_number = epoch + 1

        print(
            f"\nSaving VQ-VAE weights after epoch {epoch_number}..."
        )

        # ----------------------------------------------------
        # Save encoder
        # ----------------------------------------------------

        self.model.encoder.save_weights(
            str(ENCODER_PATH)
        )

        # ----------------------------------------------------
        # Save vector quantizer
        # ----------------------------------------------------

        vq_weights = (
            self.model.vq_layer.get_weights()
        )

        # Store arrays in a 1D object array so that
        # different weight shapes are preserved.

        weight_container = np.empty(
            len(vq_weights),
            dtype=object
        )

        for index, weight in enumerate(vq_weights):

            weight_container[index] = weight

        np.save(
            str(VQ_PATH),
            weight_container,
            allow_pickle=True
        )

        # ----------------------------------------------------
        # Save decoder
        # ----------------------------------------------------

        self.model.decoder.save_weights(
            str(DECODER_PATH)
        )

        print(
            f"\nSaved all VQ-VAE weights for epoch {epoch_number}."
        )


