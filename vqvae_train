if os.path.exists(saved_model):

    print("Previous weights found.")

    vqvae_trainer = VQVAETrainer(
        latent_dim=latent_dim,
        num_embeddings=num_embeddings
    )

    # Build model components
    dummy_input = tf.zeros((1, 224, 224, 3))
    _ = vqvae_trainer.vqvae(dummy_input)

    # Define saved weight paths
    encoder_path = MODEL_DIR / "encoder_epoch.weights.h5"
    vq_path = MODEL_DIR / "vq_epoch.npy"
    decoder_path = MODEL_DIR / "decoder_epoch.weights.h5"

    # Verify all three files exist
    if not all(os.path.exists(p) for p in [
        encoder_path, vq_path, decoder_path
    ]):
        raise FileNotFoundError(
            "One or more VQ-VAE component weight files are missing."
        )
    # Load encoder weights
    vqvae_trainer.encoder.load_weights(encoder_path)
    # Load vector quantizer weights
    vq_weights = np.load(vq_path, allow_pickle=True)
    vqvae_trainer.vq_layer.set_weights(vq_weights)

    # Load decoder weights
    vqvae_trainer.decoder.load_weights(decoder_path)

    vqvae_trainer.compile(optimizer=tf.keras.optimizers.Adam(1e-3))
    
    # Reduce batch size for larger image
    vqvae_trainer.fit(x_train, epochs=2, batch_size=16,callbacks=[SaveVQVAEWeights()]
    )
    vq_layer=vqvae_trainer.vq_layer

    initial_epoch = 4

    print("Encoder, vector quantizer and decoder restored.")

else:

