class SaveVQVAEWeights(tf.keras.callbacks.Callback):

    def on_epoch_end(self, epoch, logs=None):

        epoch_number = epoch + 1

        # Save encoder weights
        self.model.encoder.save_weights(
            str(MODEL_DIR / "encoder_epoch.weights.h5")
        )

        # Save vector quantizer weights
        np.save(
            str(MODEL_DIR / "vq_epoch.npy"),
            self.model.vq_layer.get_weights(),
            allow_pickle=True
        )

        # Save decoder weights
        self.model.decoder.save_weights(
            str(MODEL_DIR / "decoder_epoch.weights.h5")
        )

        print(f"\nSaved all weights for epoch {epoch_number}")



