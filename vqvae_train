IMAGE_DIR = IMAGE_ROOT
IMG_SIZE = (224, 224)
MAX_IMAGES = 31000

def load_single_image(path):
    img = cv2.imread(path)

    if img is None:
        return None

    img = cv2.resize(img, IMG_SIZE)
    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

    return img


def load_first_n_images(folder, img_size, n):

    files = sorted(os.listdir(folder))[:n]

    paths = [
        os.path.join(folder, f)
        for f in files
    ]

    imgs = []

    with ThreadPoolExecutor(max_workers=os.cpu_count()) as executor:

        results = executor.map(load_single_image, paths)

        for img in tqdm(
            results,
            total=len(paths),
            desc="Loading images",
            unit="image"
        ):
            if img is not None:
                imgs.append(img)

    return np.asarray(imgs, dtype=np.float32)


all_images = load_first_n_images(IMAGE_DIR, IMG_SIZE, MAX_IMAGES)
print("Loaded:", all_images.shape)

# Normalize 0–1
all_images = all_images / 255.0

x_train = all_images[:MAX_IMAGES]
x_test = all_images[MAX_IMAGES:]

