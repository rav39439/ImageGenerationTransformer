def load_image_paths(caption_map):

    print("Loading images in caption order...")

    paths = []
    missing_images = []
    unsupported_images = []

    for image_name in tqdm(
        caption_map,
        total=len(caption_map),
        desc="Loading image files",
        unit="image",
        dynamic_ncols=True
    ):

        image_path = IMAGE_DIR / image_name

        if image_path.suffix.lower() not in IMAGE_EXTENSIONS:
            unsupported_images.append(image_name)
            continue

        if not image_path.is_file():
            missing_images.append(image_name)
            continue

        paths.append(str(image_path))

    print("\n========== IMAGE SUMMARY ==========")

    print("Images requested:", len(caption_map))
    print("Images successfully loaded:", len(paths))
    print("Missing images:", len(missing_images))
    print("Unsupported images:", len(unsupported_images))

    print("===================================\n")

    if missing_images:
        print("First 20 missing images:")
        for name in missing_images[:20]:
            print(name)

    if unsupported_images:
        print("First 20 unsupported images:")
        for name in unsupported_images[:20]:
            print(name)

    if not paths:
        raise ValueError("No matching image files found.")

    return paths


# ============================================================
# VERIFY IMAGE-CAPTION MAPPING
