# ============================================================
# DECODE IMAGE TOKENS
# ============================================================

def decode_image_tokens(
    image_indices,
    codebook_embeddings,
    decoder
):

    number_of_images = tf.shape(
        image_indices
    )[0]

    quantized = tf.gather(
        codebook_embeddings,
        image_indices
    )

    quantized = tf.reshape(
        quantized,
        [
            number_of_images,
            IMAGE_TOKENS_SIDE,
            IMAGE_TOKENS_SIDE,
            LATENT_CHANNELS
        ]
    )

    # Nearest-neighbor preserves codebook vectors.
    quantized = tf.image.resize(
        quantized,
        [
            DECODER_LATENT_SIZE,
            DECODER_LATENT_SIZE
        ],
        method="nearest"
    )

    images = decoder(
        quantized,
        training=False
    )

    images = tf.cond(
        tf.reduce_min(images) < 0.0,
        lambda: (images + 1.0) / 2.0,
        lambda: images
    )

    return tf.clip_by_value(
        images,
        0.0,
        1.0
    )


# ============================================================
# GENERATE IMAGES FROM TEXT
# ============================================================

def generate_images(
    transformer,
    vectorizer,
    codebook_embeddings,
    decoder,
    prompt,
    number_of_images=4,
    temperature=1.0,
    top_k=50
):

    if temperature <= 0:
        raise ValueError(
            "Temperature must be greater than zero."
        )

    if not 1 <= top_k <= CODEBOOK_SIZE:
        raise ValueError(
            "top_k must be between 1 and CODEBOOK_SIZE."
        )

    print("\nText prompt:", prompt)

    # Text prompt to token IDs

    text_ids = vectorizer(
        tf.constant([prompt])
    )

    text_ids = tf.repeat(
        text_ids,
        repeats=number_of_images,
        axis=0
    )

    # Start with BOS

    generated = tf.fill(
        [number_of_images, 1],
        tf.cast(BOS_TOKEN, tf.int32)
    )

    # Autoregressive image-token generation

    for step in range(IMAGE_TOKEN_COUNT):

        model_inputs = {

            "text_ids": text_ids,

            "image_tokens": generated
        }

        logits = transformer(
            model_inputs,
            training=False
        )

        next_logits = logits[:, -1, :CODEBOOK_SIZE]

        next_logits = next_logits / temperature

        top_values, top_indices = tf.math.top_k(
            next_logits,
            k=top_k
        )

        sampled_position = tf.random.categorical(
            top_values,
            num_samples=1
        )

        sampled_position = tf.cast(
            sampled_position,
            tf.int32
        )

        next_token = tf.gather(
            top_indices,
            sampled_position,
            batch_dims=1
        )

        generated = tf.concat(
            [
                generated,
                next_token
            ],
            axis=1
        )

        if (step + 1) % 25 == 0:

            print(
                f"Generated tokens: "
                f"{step + 1}/{IMAGE_TOKEN_COUNT}"
            )

    image_indices = generated[:, 1:]

    images = decode_image_tokens(
        image_indices,
        codebook_embeddings,
        decoder
    )

    generation_dir = (
        OUTPUT_DIR / "generated_images"
    )

    generation_dir.mkdir(
        parents=True,
        exist_ok=True
    )

    for i in range(number_of_images):

        path = (
            generation_dir /
            f"generated_{i + 1}.png"
        )

        keras.utils.save_img(
            str(path),
            images[i]
        )

        print("Saved:", path)

    return images

