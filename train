def main():


    # --------------------------------------------------------
    # 0. Initialize multi-GPU strategy
    # --------------------------------------------------------

    gpus = tf.config.list_physical_devices("GPU")

    print("\nAvailable GPUs:", len(gpus))

    if len(gpus) < 2:
        raise RuntimeError(
            f"Expected 2 GPUs, but found {len(gpus)}."
        )
    strategy = tf.distribute.MirroredStrategy(
        devices=["/GPU:0", "/GPU:1"]
    )

    print("Number of synchronized replicas:", strategy.num_replicas_in_sync)

    # Continue with your existing code...

    # --------------------------------------------------------
    # 1. Load first 15,000 unique images and captions
    # --------------------------------------------------------

    print("\nLoading Flickr30k captions...")

    captions = load_captions(
        CAPTION_FILE
    )

    # --------------------------------------------------------
    # 2. Load images in original CSV order
    # --------------------------------------------------------

    print("\nLoading image paths...")

    paths = load_image_paths(
        captions
    )

    # --------------------------------------------------------
    # 3. Verify mapping
    # --------------------------------------------------------

    total_captions = verify_image_caption_mapping(
        paths,
        captions
    )

    # --------------------------------------------------------
    # 4. Split without shuffling
    # --------------------------------------------------------

    train_paths, val_paths = split_image_paths(
        paths
    )

    print("\nFinal dataset statistics:")

    print("Total images:", len(paths))

    print("Total captions:", total_captions)

    print("Training images:", len(train_paths))

    print("Validation images:", len(val_paths))

    # --------------------------------------------------------
    # 5. Load pretrained VQ-VAE
    # --------------------------------------------------------

    print("\nLoading pretrained VQ-VAE...")

    encoder, quantizer, decoder = load_vqvae()

    encoder.trainable = False

    quantizer.trainable = False

    decoder.trainable = False

    dummy_image = tf.zeros(
        [1, *IMAGE_SIZE, 3],
        dtype=tf.float32
    )

    dummy_latent = encoder(
        dummy_image,
        training=False
    )

    if isinstance(dummy_latent, (tuple, list)):
        dummy_latent = dummy_latent[0]

    print(
        "Encoder output shape:",
        dummy_latent.shape
    )

    codebook_embeddings = get_codebook_embeddings(
        quantizer
    )

    print(
        "Codebook embedding shape:",
        codebook_embeddings.shape
    )

    if dummy_latent.shape[-1] != LATENT_CHANNELS:

        raise ValueError(
            f"Encoder produces {dummy_latent.shape[-1]} "
            f"channels, but codebook dimension is "
            f"{LATENT_CHANNELS}."
        )

    # --------------------------------------------------------
    # 6. Precompute image tokens
    # --------------------------------------------------------

    print("\nPrecomputing VQ-VAE image tokens...")

    token_map = precompute_image_tokens(
        paths,
        encoder,
        codebook_embeddings
    )

    # --------------------------------------------------------
    # 7. Create caption-image pairs
    # --------------------------------------------------------

    print("\nCreating training pairs...")

    train_pairs = create_caption_pairs(
        train_paths,
        captions,
        token_map
    )

    val_pairs = create_caption_pairs(
        val_paths,
        captions,
        token_map
    )

    # --------------------------------------------------------
    # 8. Create text vectorizer
    # --------------------------------------------------------

    print("\nCreating text vectorizer...")

    vectorizer = create_text_vectorizer(
        train_pairs
    )

    text_vocab_size = len(
        vectorizer.get_vocabulary()
    )

    # --------------------------------------------------------
    # 9. Build datasets WITHOUT SHUFFLING
    # --------------------------------------------------------

    print("\nBuilding training dataset...")

    train_dataset = build_dataset(
        train_pairs,
        vectorizer,
        training=True
    )

    print("\nBuilding validation dataset...")

    val_dataset = build_dataset(
        val_pairs,
        vectorizer,
        training=False
    )

    # --------------------------------------------------------
    # 10. Create Transformer
    # --------------------------------------------------------

    print("\nCreating TextToImageTransformer...")

    transformer = create_transformer(
        text_vocab_size
    )

    print_model_information(
        transformer,
        encoder,
        quantizer,
        decoder
    )

    
    from pathlib import Path

    CHECKPOINT_PATH = Path(
        "/kaggle/working/pixart_finetuned/text_to_image_transformer.weights.h5"
    )
    
    if CHECKPOINT_PATH.is_file():
    
        print("\nLoading previously saved model weights...")
    
        transformer.load_weights(str(CHECKPOINT_PATH))
    
        print("Model weights loaded successfully.")
    
    else:
        print("\nNo previous checkpoint found.")
        print("Training will start with randomly initialized weights.")

    # --------------------------------------------------------
    # 11. Calculate training steps
    # --------------------------------------------------------

    steps_per_epoch = math.ceil(
        len(train_pairs) / BATCH_SIZE
    )

    total_steps = (
        steps_per_epoch * EPOCHS
    )

    print("\nTraining pairs:", len(train_pairs))

    print("Validation pairs:", len(val_pairs))

    print("Steps per epoch:", steps_per_epoch)

    print("Total training steps:", total_steps)

    # --------------------------------------------------------
    # 12. Compile
    # --------------------------------------------------------

    print("\nCompiling Transformer...")

    transformer = compile_transformer(
        transformer,
        total_steps
    )

    # --------------------------------------------------------
    # 13. Train
    # --------------------------------------------------------

    callbacks = create_callbacks()

    print("\nStarting text-to-image training...")

    history = transformer.fit(

        train_dataset,

        validation_data=val_dataset,

        epochs=EPOCHS,

        callbacks=callbacks,

        verbose=1
    )

    # --------------------------------------------------------
    # 14. Save final model weights
    # --------------------------------------------------------

    final_checkpoint = (
        OUTPUT_DIR /
        "image_transformer_final.weights.h5"
    )

    transformer.save_weights(
        str(final_checkpoint)
    )

    print(
        "\nFinal weights saved:",
        final_checkpoint
    )

    # --------------------------------------------------------
    # 15. Save configuration and vocabulary
    # --------------------------------------------------------

    save_configuration(
        vectorizer
    )

    # --------------------------------------------------------
    # 16. Generate images
    # --------------------------------------------------------

    print("\nGenerating images from text...")

    generate_images(
        transformer=transformer,
        vectorizer=vectorizer,
        codebook_embeddings=codebook_embeddings,
        decoder=decoder,
        prompt="A dog running through a green field",
        number_of_images=4,
        temperature=1.0,
        top_k=50
    )

    print("\n" + "=" * 65)

    print("TEXT-TO-IMAGE TRAINING COMPLETED")

    print("=" * 65)

    return transformer, history


