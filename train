import matplotlib.pyplot as plt
from PIL import Image
import os

# -------------------------------------------------
# DISPLAY FLICKR30K IMAGES WITH CAPTIONS
# -------------------------------------------------

def display_flickr_images(
    image_paths,
    captions,
    number_of_images=2
):

    number_of_images = min(
        number_of_images,
        len(image_paths)
    )

    fig, axes = plt.subplots(
        1,
        number_of_images,
        figsize=(7 * number_of_images, 6)
    )

    if number_of_images == 1:
        axes = [axes]

    for i, image_path in enumerate(
        image_paths[:number_of_images]
    ):

        image_name = os.path.basename(image_path)

        # Load original image
        image = Image.open(image_path).convert("RGB")

        # Get captions associated with this image
        image_captions = captions.get(
            image_name,
            []
        )

        # Display image
        axes[i].imshow(image)
        axes[i].axis("off")

        # Display first caption
        caption = (
            image_captions[0]
            if image_captions
            else "No caption available"
        )

        axes[i].set_title(
            f"Image: {image_name}\n\nCaption: {caption}",
            fontsize=10,
            wrap=True,
            pad=12
        )

    plt.tight_layout()
    plt.show()


