def split_image_paths(paths):

    split_index = int(
        len(paths) * TRAIN_RATIO
    )

    train_paths = paths[:split_index]

    val_paths = paths[split_index:]

    print("Training images:", len(train_paths))

    print("Validation images:", len(val_paths))

    return train_paths, val_paths


# ============================================================
# LOAD AND PREPROCESS IMAGES
# ============================================================

def load_image(path):

    image_bytes = tf.io.read_file(path)

    image = tf.io.decode_image(
        image_bytes,
        channels=3,
        expand_animations=False
    )

    image.set_shape([None, None, 3])

    image = tf.image.resize(
        image,
        IMAGE_SIZE
    )

    image = tf.cast(
        image,
        tf.float32
    ) / 255.0

    return image


# ============================================================
# GET VQ-VAE CODEBOOK EMBEDDINGS
# ============================================================

def get_codebook_embeddings(quantizer):

    embeddings = getattr(
        quantizer,
        "embeddings",
        None
    )

    if embeddings is None:

        embedding_layer = getattr(
            quantizer,
            "embedding",
            None
        )

        if embedding_layer is not None:

            embeddings = getattr(
                embedding_layer,
                "embeddings",
                None
            )

    if embeddings is None:
        raise AttributeError(
            "Cannot find VQ-VAE codebook embeddings."
        )

    embeddings = tf.convert_to_tensor(
        embeddings,
        dtype=tf.float32
    )

    tf.debugging.assert_equal(
        tf.shape(embeddings)[0],
        CODEBOOK_SIZE
    )

    tf.debugging.assert_equal(
        tf.shape(embeddings)[1],
        LATENT_CHANNELS
    )

    return embeddings


# ============================================================
# CONVERT ENCODER FEATURES TO IMAGE TOKENS
# ============================================================

def encode_to_image_tokens(
    images,
    encoder,
    codebook_embeddings
):

    latent = encoder(
        images,
        training=False
    )

    if isinstance(latent, (tuple, list)):
        latent = latent[0]

    tf.debugging.assert_equal(
        tf.shape(latent)[-1],
        LATENT_CHANNELS,
        message="Encoder and codebook dimensions mismatch."
    )

    latent = tf.image.resize(
        latent,
        [
            IMAGE_TOKENS_SIDE,
            IMAGE_TOKENS_SIDE
        ],
        method="area"
    )

    batch_size = tf.shape(latent)[0]

    flat_latent = tf.reshape(
        latent,
        [-1, LATENT_CHANNELS]
    )

    latent_squared = tf.reduce_sum(
        tf.square(flat_latent),
        axis=1,
        keepdims=True
    )

    embedding_squared = tf.reduce_sum(
        tf.square(codebook_embeddings),
        axis=1
    )

    distances = (
        latent_squared
        + embedding_squared[tf.newaxis, :]
        - 2.0 * tf.matmul(
            flat_latent,
            codebook_embeddings,
            transpose_b=True
        )
    )

    indices = tf.argmin(
        distances,
        axis=1,
        output_type=tf.int32
    )

    indices = tf.reshape(
        indices,
        [
            batch_size,
            IMAGE_TOKEN_COUNT
        ]
    )

    return indices


# ============================================================
# PRECOMPUTE IMAGE TOKENS
# ============================================================

def precompute_image_tokens(
    image_paths,
    encoder,
    codebook_embeddings
):

    token_map = {}

    total_batches = math.ceil(
        len(image_paths) / BATCH_SIZE
    )

    for batch_number in tqdm(
        range(total_batches),
        desc="Encoding images into VQ tokens"
    ):

        start = batch_number * BATCH_SIZE

        end = min(
            start + BATCH_SIZE,
            len(image_paths)
        )

        batch_paths = image_paths[start:end]

        images = tf.stack([
            load_image(path)
            for path in batch_paths
        ])

        tokens = encode_to_image_tokens(
            images,
            encoder,
            codebook_embeddings
        )

        tokens = tokens.numpy()

        for path, image_tokens in zip(
            batch_paths,
            tokens
        ):

            token_map[os.path.basename(path)] = (
                image_tokens.astype(np.int32)
            )

    print(
        "Precomputed image token sequences:",
        len(token_map)
    )

    return token_map


# ============================================================
# CREATE IMAGE-CAPTION PAIRS
# ============================================================

def create_caption_pairs(
    image_paths,
    captions,
    token_map
):

    pairs = []

    for image_path in image_paths:

        image_name = os.path.basename(
            image_path
        )

        if image_name not in token_map:
            continue

        for caption in captions.get(image_name, []):

            pairs.append((
                caption,
                token_map[image_name]
            ))

    if not pairs:
        raise ValueError(
            "No caption-image token pairs were created."
        )

    print(
        "Total image-caption pairs:",
        len(pairs)
    )

    return pairs


# ============================================================
# CREATE TEXT VECTORIZER
# ============================================================

def create_text_vectorizer(train_pairs):

    train_captions = [
        caption
        for caption, _ in train_pairs
    ]

    vectorizer = layers.TextVectorization(
        max_tokens=TEXT_VOCAB_LIMIT,
        standardize="lower_and_strip_punctuation",
        split="whitespace",
        output_mode="int",
        output_sequence_length=MAX_TEXT_LENGTH
    )

    vectorizer.adapt(
        tf.data.Dataset.from_tensor_slices(
            train_captions
        ).batch(1024)
    )

    vocabulary = vectorizer.get_vocabulary()

    print(
        "Text vocabulary size:",
        len(vocabulary)
    )

    return vectorizer


# ============================================================
# CREATE NEXT-TOKEN TRAINING PAIRS
# ============================================================

def prepare_transformer_inputs(image_tokens):

    batch_size = tf.shape(image_tokens)[0]

    bos = tf.fill(
        [batch_size, 1],
        tf.cast(BOS_TOKEN, tf.int32)
    )

    sequences = tf.concat(
        [bos, image_tokens],
        axis=1
    )

    inputs = sequences[:, :-1]

    targets = sequences[:, 1:]

    return inputs, targets


# ============================================================
# BUILD TEXT-IMAGE DATASET
# NO SHUFFLING
# ============================================================

def build_dataset(
    pairs,
    vectorizer,
    training=True
):

    if not pairs:
        raise ValueError(
            "Cannot build an empty dataset."
        )

    captions = [
        caption
        for caption, _ in pairs
    ]

    image_tokens = np.stack([
        tokens
        for _, tokens in pairs
    ]).astype(np.int32)

    ds = tf.data.Dataset.from_tensor_slices(
        (
            captions,
            image_tokens
        )
    )

    # IMPORTANT:
    # No ds.shuffle() here.
    # Original caption-image order is preserved.

    def convert_pair(caption, tokens):

        text_ids = vectorizer(caption)

        image_inputs, targets = (
            prepare_transformer_inputs(
                tokens[tf.newaxis, :]
            )
        )

        image_inputs = image_inputs[0]

        targets = targets[0]

        inputs = {
            "text_ids": text_ids,
            "image_tokens": image_inputs
        }

        return inputs, targets

    ds = ds.map(
        convert_pair,
        num_parallel_calls=AUTOTUNE,
        deterministic=True
    )

    ds = ds.batch(
        BATCH_SIZE,
        drop_remainder=False
    )

    return ds.prefetch(AUTOTUNE)


# ============================================================
# TEXT ENCODER BLOCK
# ============================================================

class TextEncoderBlock(layers.Layer):

    def __init__(
        self,
        d_model,
        num_heads,
        dff,
        dropout=0.1
    ):

        super().__init__()

        self.attention = layers.MultiHeadAttention(
            num_heads=num_heads,
            key_dim=d_model // num_heads,
            dropout=dropout
        )

        self.ffn = keras.Sequential([
            layers.Dense(
                dff,
                activation="gelu"
            ),
            layers.Dense(d_model)
        ])

        self.norm1 = layers.LayerNormalization(
            epsilon=1e-6
        )

        self.norm2 = layers.LayerNormalization(
            epsilon=1e-6
        )

        self.dropout1 = layers.Dropout(dropout)

        self.dropout2 = layers.Dropout(dropout)

    def call(
        self,
        x,
        padding_mask,
        training=False
    ):

        attention_mask = (
            padding_mask[:, tf.newaxis, :]
        )

        attention_output = self.attention(
            query=x,
            key=x,
            value=x,
            attention_mask=attention_mask,
            training=training
        )

        x = self.norm1(
            x + self.dropout1(
                attention_output,
                training=training
            )
        )

        ffn_output = self.ffn(
            x,
            training=training
        )

        x = self.norm2(
            x + self.dropout2(
                ffn_output,
                training=training
            )
        )

        return x


# ============================================================
# IMAGE DECODER BLOCK
# ============================================================

class ImageDecoderBlock(layers.Layer):

    def __init__(
        self,
        d_model,
        num_heads,
        dff,
        dropout=0.1
    ):

        super().__init__()

        self.self_attention = layers.MultiHeadAttention(
            num_heads=num_heads,
            key_dim=d_model // num_heads,
            dropout=dropout
        )

        self.cross_attention = layers.MultiHeadAttention(
            num_heads=num_heads,
            key_dim=d_model // num_heads,
            dropout=dropout
        )

        self.ffn = keras.Sequential([
            layers.Dense(
                dff,
                activation="gelu"
            ),
            layers.Dense(d_model)
        ])

        self.norm1 = layers.LayerNormalization(
            epsilon=1e-6
        )

        self.norm2 = layers.LayerNormalization(
            epsilon=1e-6
        )

        self.norm3 = layers.LayerNormalization(
            epsilon=1e-6
        )

        self.dropout1 = layers.Dropout(dropout)

        self.dropout2 = layers.Dropout(dropout)

        self.dropout3 = layers.Dropout(dropout)

    def call(
        self,
        image_x,
        text_memory,
        text_padding_mask,
        training=False
    ):

        # Causal self-attention

        attention_output = self.self_attention(
            query=image_x,
            key=image_x,
            value=image_x,
            use_causal_mask=True,
            training=training
        )

        image_x = self.norm1(
            image_x + self.dropout1(
                attention_output,
                training=training
            )
        )

        # Cross-attention

        cross_attention_mask = (
            text_padding_mask[:, tf.newaxis, :]
        )

        cross_output = self.cross_attention(
            query=image_x,
            key=text_memory,
            value=text_memory,
            attention_mask=cross_attention_mask,
            training=training
        )

        image_x = self.norm2(
            image_x + self.dropout2(
                cross_output,
                training=training
            )
        )

        # Feed-forward

        ffn_output = self.ffn(
            image_x,
            training=training
        )

        image_x = self.norm3(
            image_x + self.dropout3(
                ffn_output,
                training=training
            )
        )

        return image_x


# ============================================================
# TEXT-TO-IMAGE TRANSFORMER
# ============================================================

class TextToImageTransformer(keras.Model):

    def __init__(
        self,
        text_vocab_size,
        image_vocab_size=1025,
        d_model=256,
        num_heads=8,
        num_layers=26,
        text_encoder_layers=4,
        dff=1024,
        max_text_length=64,
        max_image_length=196,
        dropout=0.1
    ):

        super().__init__()

        self.d_model = d_model

        self.image_vocab_size = image_vocab_size

        # Text embeddings

        self.text_embedding = layers.Embedding(
            input_dim=text_vocab_size,
            output_dim=d_model,
            mask_zero=False
        )

        self.text_position_embedding = layers.Embedding(
            input_dim=max_text_length,
            output_dim=d_model
        )

        self.text_encoder_blocks = [
            TextEncoderBlock(
                d_model=d_model,
                num_heads=num_heads,
                dff=dff,
                dropout=dropout
            )
            for _ in range(text_encoder_layers)
        ]

        self.text_dropout = layers.Dropout(dropout)

        # Image embeddings

        self.image_embedding = layers.Embedding(
            input_dim=image_vocab_size,
            output_dim=d_model
        )

        self.image_position_embedding = layers.Embedding(
            input_dim=max_image_length,
            output_dim=d_model
        )

        self.image_decoder_blocks = [
            ImageDecoderBlock(
                d_model=d_model,
                num_heads=num_heads,
                dff=dff,
                dropout=dropout
            )
            for _ in range(num_layers)
        ]

        self.image_dropout = layers.Dropout(dropout)

        self.output_layer = layers.Dense(
            image_vocab_size
        )

    def call(
        self,
        inputs,
        training=False
    ):

        text_ids = inputs["text_ids"]

        image_tokens = inputs["image_tokens"]

        text_length = tf.shape(text_ids)[1]

        image_length = tf.shape(image_tokens)[1]

        # Text encoding

        text_positions = tf.range(
            text_length
        )[tf.newaxis, :]

        text_padding_mask = tf.not_equal(
            text_ids,
            0
        )

        text_x = self.text_embedding(
            text_ids
        )

        text_x *= tf.math.sqrt(
            tf.cast(
                self.d_model,
                tf.float32
            )
        )

        text_x += self.text_position_embedding(
            text_positions
        )

        text_x = self.text_dropout(
            text_x,
            training=training
        )

        for block in self.text_encoder_blocks:

            text_x = block(
                text_x,
                text_padding_mask,
                training=training
            )

        # Image token embeddings

        image_positions = tf.range(
            image_length
        )[tf.newaxis, :]

        image_x = self.image_embedding(
            image_tokens
        )

        image_x *= tf.math.sqrt(
            tf.cast(
                self.d_model,
                tf.float32
            )
        )

        image_x += self.image_position_embedding(
            image_positions
        )

        image_x = self.image_dropout(
            image_x,
            training=training
        )

        # Caption-conditioned decoding

        for block in self.image_decoder_blocks:

            image_x = block(
                image_x=image_x,
                text_memory=text_x,
                text_padding_mask=text_padding_mask,
                training=training
            )

        logits = self.output_layer(
            image_x
        )

        return logits


# ============================================================
# CREATE TRANSFORMER
# ============================================================

def create_transformer(text_vocab_size):

    model = TextToImageTransformer(

        text_vocab_size=text_vocab_size,

        image_vocab_size=CODEBOOK_SIZE + 1,

        d_model=EMBED_DIM,

        num_heads=NUM_HEADS,

        num_layers=NUM_LAYERS,

        text_encoder_layers=TEXT_ENCODER_LAYERS,

        dff=DFF,

        max_text_length=MAX_TEXT_LENGTH,

        max_image_length=MAX_POSITION_ENCODING,

        dropout=DROPOUT
    )

    dummy_inputs = {

        "text_ids": tf.ones(
            [1, MAX_TEXT_LENGTH],
            dtype=tf.int32
        ),

        "image_tokens": tf.zeros(
            [1, IMAGE_TOKEN_COUNT],
            dtype=tf.int32
        )
    }

    dummy_logits = model(
        dummy_inputs,
        training=False
    )

    tf.debugging.assert_equal(
        tf.shape(dummy_logits)[1],
        IMAGE_TOKEN_COUNT
    )

    tf.debugging.assert_equal(
        tf.shape(dummy_logits)[2],
        CODEBOOK_SIZE + 1
    )

    print(
        "Transformer output shape:",
        dummy_logits.shape
    )

    return model


# ============================================================
# OPTIMIZER
# ============================================================

def create_optimizer(total_steps):

    learning_rate = keras.optimizers.schedules.CosineDecay(
        initial_learning_rate=INITIAL_LR,
        decay_steps=total_steps,
        alpha=MIN_LR / INITIAL_LR
    )

    return keras.optimizers.Adam(
        learning_rate=learning_rate,
        beta_1=0.9,
        beta_2=0.999,
        epsilon=1e-7
    )


# ============================================================
# COMPILE TRANSFORMER
# ============================================================

def compile_transformer(
    model,
    total_steps
):

    model.compile(

        optimizer=create_optimizer(
            total_steps
        ),

        loss=keras.losses.SparseCategoricalCrossentropy(
            from_logits=True
        ),

        metrics=[
            keras.metrics.SparseCategoricalAccuracy(
                name="accuracy"
            )
        ]
    )

    return model


# ============================================================
# CALLBACKS
# ============================================================

def create_callbacks():

    checkpoint_path = (
        OUTPUT_DIR /
        "text_to_image_transformer.weights.h5"
    )

    checkpoint_callback = keras.callbacks.ModelCheckpoint(

        filepath=str(checkpoint_path),

        save_weights_only=True,

        save_best_only=False,

        save_freq="epoch",

        verbose=1
    )

    return [
        checkpoint_callback,
        keras.callbacks.TerminateOnNaN()
    ]


