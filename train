def verify_image_caption_mapping(
    image_paths,
    captions
):

    image_names = [
        os.path.basename(path)
        for path in image_paths
    ]

    image_name_set = set(image_names)

    missing_caption_names = [
        name
        for name in image_names
        if name not in captions
    ]

    caption_without_image = [
        name
        for name in captions
        if name not in image_name_set
    ]

    total_captions = sum(
        len(captions[name])
        for name in image_names
        if name in captions
    )

    multiple_caption_images = sum(
        len(captions[name]) > 1
        for name in image_names
        if name in captions
    )

    print("\n========== DATASET VERIFICATION ==========")

    print("Unique images:", len(image_names))

    print("Total captions:", total_captions)

    print(
        "Images without captions:",
        len(missing_caption_names)
    )

    print(
        "Caption filenames without images:",
        len(caption_without_image)
    )

    print(
        "Images with multiple captions:",
        multiple_caption_images
    )

    print("==========================================\n")

    if missing_caption_names:
        raise ValueError(
            "Some loaded images have no captions."
        )

    if len(image_names) > MAX_IMAGES:
        raise ValueError(
            "Loaded more than MAX_IMAGES."
        )

    return total_captions


