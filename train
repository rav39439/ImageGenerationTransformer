def load_captions(caption_file):

    if not os.path.isfile(caption_file):
        raise FileNotFoundError(
            f"Caption file not found: {caption_file}"
        )

    captions = {}

    skipped_rows = 0
    total_caption_rows = 0

    with open(
        caption_file,
        "r",
        encoding="utf-8-sig",
        newline=""
    ) as file:

        sample = file.read(8192)
        file.seek(0)

        try:
            dialect = csv.Sniffer().sniff(
                sample,
                delimiters=",|\t;"
            )
        except csv.Error:
            dialect = csv.excel

        reader = csv.DictReader(
            file,
            dialect=dialect
        )

        if not reader.fieldnames:
            raise ValueError(
                "Invalid caption CSV."
            )

        field_map = {
            name.strip().lower(): name
            for name in reader.fieldnames
            if name
        }

        image_column = None
        caption_column = None

        for key, original in field_map.items():

            if key in {
                "image",
                "image_name",
                "filename",
                "file_name"
            }:
                image_column = original

            if key in {
                "caption",
                "comment",
                "description",
                "text"
            }:
                caption_column = original

        if image_column is None:
            image_column = reader.fieldnames[0]

        if caption_column is None:
            caption_column = reader.fieldnames[-1]

        if image_column == caption_column:
            raise ValueError(
                f"Invalid CSV columns: {reader.fieldnames}"
            )

        # Preserve original CSV ordering.
        for row in reader:

            image_name = row.get(image_column)
            caption = row.get(caption_column)

            if not image_name or not caption:
                skipped_rows += 1
                continue

            image_name = os.path.basename(
                image_name.strip()
            )

            caption = caption.strip()

            if not image_name or not caption:
                skipped_rows += 1
                continue

            # Only select the first 15,000 unique images.
            if image_name not in captions:

                if len(captions) >= MAX_IMAGES:
                    continue

                captions[image_name] = []

            # Keep every caption for selected images.
            captions[image_name].append(caption)

            total_caption_rows += 1

    if not captions:
        raise ValueError(
            "No valid image-caption records found."
        )

    print("\n========== CAPTION SUMMARY ==========")

    print(
        "Unique images selected:",
        len(captions)
    )

    print(
        "Total captions loaded:",
        total_caption_rows
    )

    print(
        "Skipped CSV rows:",
        skipped_rows
    )

    print(
        "Average captions per image:",
        round(
            total_caption_rows / len(captions),
            2
        )
    )

    if total_caption_rows > len(captions):
        print(
            "Multiple captions per image detected."
        )

    if len(captions) < MAX_IMAGES:
        print(
            "WARNING: Fewer than 15,000 unique images "
            "were found in the CSV."
        )

    print("=====================================\n")

    return captions



def load_image_paths(caption_map):

    print("Loading images in caption order...")

    paths = []
    missing_images = []
    unsupported_images = []

    for image_name in tqdm(
        caption_map,
        total=len(caption_map),
        desc="Loading image files",
        unit="image",
        dynamic_ncols=True
    ):

        image_path = IMAGE_DIR / image_name

        if image_path.suffix.lower() not in IMAGE_EXTENSIONS:
            unsupported_images.append(image_name)
            continue

        if not image_path.is_file():
            missing_images.append(image_name)
            continue

        paths.append(str(image_path))

    print("\n========== IMAGE SUMMARY ==========")

    print("Images requested:", len(caption_map))
    print("Images successfully loaded:", len(paths))
    print("Missing images:", len(missing_images))
    print("Unsupported images:", len(unsupported_images))

    print("===================================\n")

    if missing_images:
        print("First 20 missing images:")
        for name in missing_images[:20]:
            print(name)

    if unsupported_images:
        print("First 20 unsupported images:")
        for name in unsupported_images[:20]:
            print(name)

    if not paths:
        raise ValueError("No matching image files found.")

    return paths


